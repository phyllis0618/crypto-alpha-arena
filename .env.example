# Optional: enable LLM-based trading agents (JSON tool-style decisions)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: multi-agent backtest / replay uses Binance public K lines (no key)
# USE_BINANCE_FEED=1

# Alpha Arena + BTC Arena: CoinGlass Open API v4 (HTTP header CG-API-KEY)
# Get key: https://www.coinglass.com (account → API)
# COINGLASS_API_KEY=your_key_here
# COINGLASS_API_BASE=https://open-api-v4.coinglass.com
# BTC Arena: futures OHLC (CoinGlass aggregates exchange feeds; not your Binance API call)
# COINGLASS_FUTURES_EXCHANGE=Binance
# COINGLASS_FUTURES_SYMBOL=BTCUSDT
# COINGLASS_FUTURES_INTERVAL=4h

# BTC Arena: local Llama via Ollama (no OpenAI key). Install from https://ollama.com then:
#   ollama pull llama3.2
# BTC_ARENA_USE_LLM=1
# BTC_ARENA_OLLAMA_URL=http://127.0.0.1:11434
# BTC_ARENA_OLLAMA_MODEL=llama3.2
# BTC_ARENA_OLLAMA_TIMEOUT=120
# Rumor lab: second Ollama call (extract → validate → rumor_signal JSON). Set 0 to skip validation.
# BTC_ARENA_RUMOR_VALIDATE=1
# COINGLASS_FUTURES_OHLC_LIMIT=120
# Extra REST probes per refresh — default 0 to avoid 429 rate limits. Increase slowly (e.g. 8).
# COINGLASS_PROBE_MAX=0
# Delay between probe requests when PROBE_MAX > 0 (seconds)
# COINGLASS_PROBE_DELAY_SEC=0.45
# Retries for /api/futures/price/history when CoinGlass returns 429 (HTTP or JSON body)
# COINGLASS_OHLC_RETRIES=5
# COINGLASS_RETRY_DELAY_SEC=1.25

# BTC Arena: blend FRED+SEC macro into rules edge (set 0 to ignore)
# BTC_ARENA_USE_MACRO=1
# BTC_ARENA_MACRO_EDGE_WEIGHT=0.00012

# X / Twitter API v2 — optional; needs Developer Portal Bearer token (not free scraping)
# TWITTER_BEARER_TOKEN=
# TWITTER_MONITOR_USERNAMES=elonmusk,realDonaldTrump

# FRED API — free, official Fed data (Federal Funds Effective Rate DFF for Macro/News Agent)
# Apply (no charge): https://fredaccount.stlouisfed.org/apikeys
# After signup, paste key below:
# FRED_API_KEY=your_fred_key_here

# Optional paths for FastAPI JSON
# ALPHA_ARENA_LEADERBOARD_JSON=
# ALPHA_ARENA_LIVE_CONTEXT_JSON=

# SEC RSS requires a descriptive User-Agent
# HTTP_USER_AGENT=AlphaArenaMacroBot/1.0 (your-email@example.com)

# FastAPI 启动后后台实时拉取（默认开启）
# ENABLE_LIVE_FEED=1
# LIVE_POLL_INTERVAL_SEC=45
